{
  "manifest_version": 3,
  "name": "PushState Guardian",
  "version": "8.4.1",
  "description": "Calm browsing protection with v8.4.1 overlay reveal fixes, stable themes, and cognitive minimalism.",
  
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["page_bridge.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "scripting",
    "tabs",
    "activeTab",
    "storage",
    "downloads"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js",
        "overlay.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "PushState Guardian",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
